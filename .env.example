# Required. The password typed on the consent page. Use at least 12 characters
# and nothing easy to guess, or the server will not start.
OWNER_PASSWORD=

# The public https origin of this server, with no path.
# Leave unset for local use; it then defaults to http://127.0.0.1:$PORT.
PUBLIC_URL=

# Local listen address.
HOST=127.0.0.1
PORT=3000

# Comma separated browser origins allowed to call /mcp, besides PUBLIC_URL.
ALLOWED_ORIGINS=

# Set to 1 only behind one reverse proxy that appends to X-Forwarded-For.
# Behind a proxy with this unset, all callers share one set of rate limits.
TRUST_PROXY=
